<?xml version="1.0" encoding="utf-8"?>
<!--
  아로새김(Arosaegim) 매니페스트.
  - Pleos Connect 차량 SDK 권한: 네비 경로/지도, 융합 위치, 차량 정보/주행/에너지, TTS
  - 로터리(다이얼) 지원 안 함: 01문서 규칙에 따라 ROTARY_SUPPORTED=false 명시
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pleos SDK 권한 -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_CUSTOM_MAP" />
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <uses-permission android:name="pleos.car.permission.CAR_INFO" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <!-- CAR_ENERGY: 연료(Fuel)·EV 배터리(EvBattery) capability 조회(U5·D1·D2·U15·U16)에 쓴다.
         Vehicle AAR 2.3.2 매니페스트 확인 결과(2026-11-12): SDK 가 직접 요구하는 권한은
         ai.pleos.playground.service.vehicle.VEHICLE_BINDING 하나뿐이고 Fuel·EvBattery 별도
         권한은 없다 — 이 CAR_ENERGY 로 커버한다. 실측에서 FAILED:SecurityException 이 나오면
         그때 재확인한다(추측으로 권한 추가 금지). -->
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <!-- Seat 점유 조회(U11·T5-1): CAR_SEATS 누락 시 capability check 가 need Permission 으로 실패한다(U11 재실측 2026-11-11) -->
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />

    <!-- 코스 데이터 원격 조회용 (릴리스는 HTTPS 전제) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".ArosaegimApp"
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:theme="@style/Theme.Arosaegim"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- 로터리 컨트롤러 미지원 선언 (01문서 규칙) -->
        <meta-data
            android:name="com.hmg.rotary.ROTARY_SUPPORTED"
            android:value="false" />

        <!-- 진단 화면: 개발 중 런처 (릴리스에서 BuildConfig로 차단 예정) -->
        <activity
            android:name="app.arosaegim.ui.driving.DiagnosticsActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 주행 화면: distractionOptimized 선언으로 주행 중 사용 가능 -->
        <activity
            android:name="app.arosaegim.ui.driving.DrivingActivity"
            android:exported="true">
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>

        <!-- 정차 화면: 주차 상태 전용 (외부 노출 없음) -->
        <activity
            android:name="app.arosaegim.ui.parked.ParkedActivity"
            android:exported="false" />

        <!-- 시작 화면(T9-1): 가족 코드 접속 / 가족 없이 둘러보기.
             launcher 는 DiagnosticsActivity 로 유지한다(개발 루프 보존).
             릴리스 흐름은 DiagnosticsActivity 가 BuildConfig.DEBUG=false 일 때
             StartActivity 로 리다이렉트한다(DiagnosticsActivity 주석 참조). -->
        <activity
            android:name="app.arosaegim.ui.session.StartActivity"
            android:exported="false" />

        <!-- Gleo 음성 function calling 수신 서비스 — 단일 서비스가 3개 도구(GET_NEXT_STAMP_PLACE·
             START_QUIZ·GET_TODAY_SUMMARY)를 모두 받는다(스키마: assets/schema.json).
             원문 미확인 확정(T0) — exported="true" 는 DiagnosticsActivity·DrivingActivity
             선례의 유추값이다. intent-filter·DO meta-data·새 권한은 추가하지 않는다. -->
        <service
            android:name="app.arosaegim.agent.GleoActionService"
            android:exported="true" />

        <!-- Gleo 호출 수신 리시버 — 서비스와 같은 계약(AgentCallHandler.handle)을 받는다.
             수신 경로가 원문 미확인이라 서비스·리시버 둘 다 같은 계약을 받는다 — adb 검증은
             리시버로 한다(T6 실측: Android 12+ 백그라운드 시작 제한으로 shell startService 는
             막히고, am broadcast 는 열려 있다. 실제 음성 경로는 서비스를 유지한다). -->
        <receiver
            android:name="app.arosaegim.agent.GleoActionReceiver"
            android:exported="true" />
    </application>
</manifest>
